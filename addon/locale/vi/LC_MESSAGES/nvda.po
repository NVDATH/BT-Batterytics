#. to be shown on installation and add-on information found in add-on store
#: addon/globalPlugins/btBatterytics.py:48
#: addon/globalPlugins/btBatterytics.py:3568 buildVars.py:21
msgid "BT-Batterytics"
msgstr "BT-Batterytics"

#: addon/globalPlugins/btBatterytics.py:620
#: addon/globalPlugins/btBatterytics.py:1497
#, python-brace-format
msgid "{days} days"
msgstr "{days} ngày"

#. Translators: duration in minutes only, e.g. '45 min'
#: addon/globalPlugins/btBatterytics.py:626
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} phút"

#. Translators: duration in whole hours only, e.g. '2 hr'
#: addon/globalPlugins/btBatterytics.py:629
#, python-brace-format
msgid "{hours} hr"
msgstr "{hours} giờ"

#. Translators: duration in hours and minutes, e.g. '1 hr 25 min'
#: addon/globalPlugins/btBatterytics.py:631
#, python-brace-format
msgid "{hours} hr {minutes} min"
msgstr "{hours} giờ {minutes} phút"

#. Translators: battery level range of one cycle, from the level at its start to the lowest level, e.g. '100% to 23%'
#: addon/globalPlugins/btBatterytics.py:1489
#, python-brace-format
msgid "{start}% to {end}%"
msgstr "{start}% đến {end}%"

#. Translators: battery life trend, recent cycles are about as long as earlier ones
#: addon/globalPlugins/btBatterytics.py:1543
msgid "stable"
msgstr "ổn định"

#. Translators: battery life trend, recent cycles are shorter than earlier ones, e.g. '12% shorter'
